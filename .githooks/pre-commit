#!/bin/sh
# Keep the experiment catalog honest. If a commit touches the published capsule
# set (or the generator) without refreshing docs/experiments.md, fail loud —
# a stale catalog advertises experiments that don't match the repo.
#
# Installed by setup.sh via: git config core.hooksPath .githooks
set -e

# Refuse direct commits to main branch to prevent squash-merge git divergence.
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" = "main" ]; then
    echo "" >&2
    echo "  [pre-commit] REFUSING COMMIT: Committing directly to 'main' is not allowed." >&2
    echo "  Please commit your changes to a feature branch instead:" >&2
    echo "       git switch -c feature/your-topic" >&2
    echo "  (To bypass in an emergency, use: git commit --no-verify)" >&2
    echo "" >&2
    exit 1
fi


ROOT="$(git rev-parse --show-toplevel)"

# Only enforce when something that affects the catalog is staged, so unrelated
# commits never depend on a working Python environment.
if git diff --cached --name-only | grep -qE '^(sql_benchmarks/experiments/results/|docs/experiments\.md|scripts/tools/gen_experiment_catalog\.py)'; then
    PY="$ROOT/venv/bin/python"
    [ -x "$PY" ] || PY="$(command -v python3 || true)"
    if [ -z "$PY" ]; then
        echo "pre-commit: no python found to verify the experiment catalog" >&2
        exit 1
    fi
    if ! "$PY" "$ROOT/scripts/tools/gen_experiment_catalog.py" --check; then
        echo "" >&2
        echo "  -> The experiment catalog is stale. Regenerate and re-stage:" >&2
        echo "       python scripts/tools/gen_experiment_catalog.py" >&2
        echo "       git add docs/experiments.md" >&2
        exit 1
    fi
fi

# Keep doc CLAIMS honest. When docs or the capsule set change, every capsule a
# doc cites must resolve to a real, git-tracked, sealed capsule — catches
# fabricated/stale IDs and broken links (the recurring hand-typed-fact bug).
# Stdlib only, so it runs even without a venv.
if git diff --cached --name-only | grep -qE '^(README\.md|AGENTS\.md|docs/|sql_benchmarks/experiments/results/)'; then
    PY="$ROOT/venv/bin/python"
    [ -x "$PY" ] || PY="$(command -v python3 || true)"
    if [ -n "$PY" ] && ! "$PY" "$ROOT/scripts/tools/verify_doc_claims.py" --check; then
        echo "" >&2
        echo "  -> A doc cites a capsule that isn't tracked+sealed. Fix the reference," >&2
        echo "     or add a known non-capsule hex to IGNORE in verify_doc_claims.py." >&2
        exit 1
    fi
fi

# --- committer identity gate -------------------------------------------
# Commits must use the masked GitHub address, never a real one.
MASKED="17259677+rctruta@users.noreply.github.com"
actual=$(git config user.email)
if [ "$actual" != "$MASKED" ]; then
  echo "BLOCKED: commit email is '$actual', expected '$MASKED'" >&2
  echo "  fix: git config user.email \"$MASKED\"" >&2
  exit 1
fi

# --- gates from ai-agent-utils, registry version 5 ---------------------
# Adopted 2026-10-19, deliberately PARTIAL. verify.py and scan.py are NOT
# installed: this repository already has its own claim verification in
# scripts/tools/verify_doc_claims.py, wired above, and two registries
# disagreeing about the same numbers is worse than one. prove_gates.sh reports
# the uninstalled ones as skipped, not failed -- a partial adoption is not a
# failure.
#
# check_wheel.py lives in scripts/dev/ rather than .gates/ because it gates a
# distribution, so it belongs to the release workflow, not to a commit.
ROOT="$(git rev-parse --show-toplevel)"
if [ -d "$ROOT/.gates" ]; then
  PY="$(command -v python3 || true)"
  if [ -n "$PY" ]; then
    # One entry point for every publishing surface. check_server_manifest is
    # called from the contract rather than separately, so there is a single
    # place that knows what publishing requires.
    # The taxonomy is hand-authored; the suites are discovered from disk.
    # Nothing connected the two, so adding a suite silently left it out of
    # every category query while still appearing in list_suites.
    "$PY" "$ROOT/scripts/dev/check_taxonomy.py" --check || {
      echo "  -> taxonomy.yaml has drifted from the suites on disk." >&2; exit 1; }
    "$PY" "$ROOT/scripts/dev/check_publish_contract.py" --check || {
      echo "  -> A publishing surface is missing required information." >&2; exit 1; }
    "$PY" "$ROOT/.gates/no_private_marker.py" --check || {
      echo "  -> A tracked file declares itself private." >&2; exit 1; }
    "$PY" "$ROOT/.gates/scratch_external.py" --check || {
      echo "  -> A local notes folder is reachable by git, or a note is tracked." >&2; exit 1; }
    "$PY" "$ROOT/.gates/no_orphans.py" --check || {
      echo "  -> A module is imported only by its own test. A passing test" >&2
      echo "     there certifies a feature that never runs." >&2; exit 1; }
    "$PY" "$ROOT/.gates/check_voice.py" --check || {
      echo "  -> A source file writes about her in the third person." >&2; exit 1; }
  fi
fi
