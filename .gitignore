# --- Python & Environment ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
env/
venv/
.venv/
.env
.DS_Store

# --- Dagster Internals ---
.dagster/
tmp_dagster*/
.tmp_dagster_home*/
*.err
*.out
*.complete

# Distribution
*.egg-info/
build/
dist/

# --- Heavy Data (The Blockers) ---
# Root data dir only — an unanchored 'data/' would also ignore source
# packages like sql_benchmarks/api/data/
/data/
*.duckdb
*.parquet
*.wal
*.db

# --- Generated Results & Artifacts ---
# Block the results folders so we don't push 100MB CSVs
sql_benchmarks/results/
sql_benchmarks/experiments/results/
sql_benchmarks/experiments/configs/
sql_benchmarks/experiments/violations/
sql_benchmarks/experiments/reports/
*.csv
*.html
*.log
.logs_queue/

# --- Infrastructure & Secrets ---
.terraform/
terraform.tfstate*
*.tfvars
*.tfvars.json
*.pem
license.xml

# --- Internal Storage (Indirected) ---
dagster_home/
.telemetry/

# --- Local-only / non-committed (Markdown is otherwise tracked by default) ---
# Put any local notes/drafts in scratch/ — nothing there is committed except
# its README. This replaces the old blanket '*.md' ignore, which silently hid
# new docs (it once dropped FAQ.md).
scratch/*
!scratch/README.md
ARTICLE_DRAFT.md                                   # article scaffold (local)
architecture/                                      # unpublished red-team/AI-security WIP
sql_benchmarks/experiments/reports/                # runtime-generated report output
.pytest_cache/                                     # test cache
audit.lock

# --- PUBLISHED CAPSULES ---------------------------------------------------
# Canonical evidence for published claims is committed deliberately: anyone
# citing experiment ID X can open results/X and verify. Everything else in
# results/ and configs/ remains runtime state and stays ignored.
!sql_benchmarks/experiments/results/48c92f31/
!sql_benchmarks/experiments/results/48c92f31/**
!sql_benchmarks/experiments/results/2d0105fe/
!sql_benchmarks/experiments/results/2d0105fe/**
!sql_benchmarks/experiments/results/40f422d5/
!sql_benchmarks/experiments/results/40f422d5/**
!sql_benchmarks/experiments/configs/config_48c92f31.yaml
!sql_benchmarks/experiments/configs/config_2d0105fe.yaml
!sql_benchmarks/experiments/configs/config_40f422d5.yaml
!sql_benchmarks/experiments/results/86aececc/
!sql_benchmarks/experiments/results/86aececc/**
!sql_benchmarks/experiments/configs/config_86aececc.yaml

# Selectivity study — indexed vs no-index Postgres + Quack/DuckDB lanes
!sql_benchmarks/experiments/results/461beee8/
!sql_benchmarks/experiments/results/461beee8/**
!sql_benchmarks/experiments/configs/config_461beee8.yaml
!sql_benchmarks/experiments/results/28f7aa1c/
!sql_benchmarks/experiments/results/28f7aa1c/**
!sql_benchmarks/experiments/configs/config_28f7aa1c.yaml

# Work-in-progress experiment configs (unpublished research — local only)
sql_benchmarks/experiments/wip/

# Claude Code worktrees & local session state — full checkouts that live
# under .claude/ and otherwise show as thousands of untracked files in the
# primary checkout. (Nothing here belongs in the repo.)
.claude/worktrees/
.claude/settings.local.json

# Stray/abandoned virtualenvs from migrations (venv/ already covered above)
venv.old*

# OpenTimestamps proofs for published capsule seals
!sql_benchmarks/experiments/results/48c92f31/integrity.seal.ots
!sql_benchmarks/experiments/results/2d0105fe/integrity.seal.ots
!sql_benchmarks/experiments/results/40f422d5/integrity.seal.ots
!sql_benchmarks/experiments/results/86aececc/integrity.seal.ots

# Act 0 — exploratory origin capsule (historical; not part of the verified
# signed set; pre-migration hashing so not re-derivable to this ID)
!sql_benchmarks/experiments/results/b82b4eae/
!sql_benchmarks/experiments/results/b82b4eae/**
